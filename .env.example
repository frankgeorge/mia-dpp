# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
# Sign up free at https://clerk.com → Create application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk routing — keep these as-is unless you rename the pages
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/workspace
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/workspace

# Optional. Without it the Python backend uses deterministic demo mode.
OPENROUTER_API_KEY=sk-or-...
# Autonomous agent model.
MIA_AGENT_MODEL=deepseek/deepseek-v3.2

# ── Database (Supabase / Neon) ─────────────────────────────────────────────────
# Required for supplier sessions and passport history persistence.
# Get from Supabase → Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-X-XX-XXXX-X.pooler.supabase.com:6543/postgres

# ── Email outreach (optional) ──────────────────────────────────────────────────
# Sign up at https://resend.com — free tier covers 100 emails/day.
# Without this key, MIA returns a plain-text email draft that you can
# copy-paste and send manually. The supplier portal still works either way.
RESEND_API_KEY=re_...

# ── Supplier portal base URL ───────────────────────────────────────────────────
# Set this to your deployed URL so the portal links in emails are correct.
# Defaults to https://mia-dpp.vercel.app in production.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
